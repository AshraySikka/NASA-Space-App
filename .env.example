# Copy to .env. Keys stay on the server; nothing here is ever sent to the browser.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_WEB_SEARCH_TOOL=web_search_20250305
ALLOWED_DOMAINS=psi.nasa.gov,ntrs.nasa.gov,www.nasa.gov,sma.nasa.gov,spinoff.nasa.gov,humans-in-space.jaxa.jp,discovery.ucl.ac.uk,par.nsf.gov,doi.org
FRONTEND_ORIGIN=http://localhost:5173
